# Copy this file to .env (same folder, the repo root) and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=

# Optional: use different models, e.g. openai:gpt-5 (then set OPENAI_API_KEY and pip install "pydantic-ai-slim[openai]")
# CC_AGENT_MODEL=anthropic:claude-sonnet-5-5       # answers most chats (cheaper)
# CC_ESCALATION_MODEL=anthropic:claude-opus-5-5    # turns that lean on the saved conversation
# CC_FACTCHECK_MODEL=anthropic:claude-sonnet-5-5   # the fact-checker agent

# Optional: use an OpenAI-compatible AI gateway (e.g. a course/university gateway) instead of Anthropic directly.
# CC_LLM_BASE_URL=https://<gateway-host>/v1
# CC_LLM_API_KEY=
# CC_AGENT_MODEL=<model name the gateway expects>
